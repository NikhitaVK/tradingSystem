# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is git-ignored — never commit real keys.

# ── Required ──────────────────────────────────────────────────────────────────
# Claude API key (https://console.anthropic.com/) — used by the strategy/analyst agents.
ANTHROPIC_API_KEY=

# Binance Testnet keys (https://testnet.binance.vision/) — paper trading only, no real money.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# ── Optional (sensible defaults exist in config/settings.py) ──────────────────
# Where the SQLite database file lives.
DB_PATH=./trading_system.db

# Override the default Claude models if desired.
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
